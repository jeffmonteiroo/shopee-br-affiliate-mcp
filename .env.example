# Example only. The server does not automatically load this file.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_ACCOUNT_REFERENCE=minha-conta
# Set absolute paths appropriate to the deployment:
SHOPEE_VERIFIED_PROFILE=/opt/shopee-affiliate-mcp/examples/profile.official.json
SHOPEE_HISTORY_DB=/opt/shopee-affiliate-mcp/data/history.sqlite3

# oauth-http: credenciais Shopee vêm do formulário. Guarde a chave abaixo como segredo.
MCP_CREDENTIALS_KEY=
MCP_STATE_DB=/app/data/oauth.sqlite3
MCP_PUBLIC_URL=https://mcp.example.com
MCP_ALLOW_LOOPBACK_CALLBACKS=false
# Opcional: callbacks exatos adicionais para Hermes.
MCP_OAUTH_REDIRECT_URIS=[]
